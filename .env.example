# ==============================================================================
# TrendRadar-AI Environment Variables Template
# Copy this file to .env and configure your secrets locally.
# Never commit your actual .env file to version control.
# ==============================================================================

# LLM Intelligence Briefings (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Future Live Ingestion Credentials (Reddit API / PRAW)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=trendradar-ai:v1.0 (by /u/your_username)

# Runtime Logging & Configuration
LOG_LEVEL=INFO
CONFIG_PATH=config.yaml
